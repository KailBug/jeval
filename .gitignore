.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# TypeScript, frontend and Electron build output
dist/
out/
build/
release/
!scripts/build/
!scripts/release/
*.tsbuildinfo
.vite/
.cache/
.turbo/
.eslintcache
.stylelintcache

